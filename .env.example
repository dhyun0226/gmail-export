# Google OAuth2 설정
# Google Cloud Console에서 생성한 OAuth 2.0 클라이언트 ID 정보
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 배포 시 변경 필요
PUBLIC_APP_URL=http://localhost:3000

# Mailnara IMAP (server-only; never expose these through runtimeConfig.public)
MAIL_IMAP_HOST=mail.brct.co.kr
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_USER=your-mailnara-email
MAIL_IMAP_PASSWORD=your-mailnara-password
MAIL_IMAP_MAILBOX=INBOX

# AI 문서 추출 설정
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# 유니패스 API 인증키
UNIPASS_API_KEY=your-unipass-api-key
UNIPASS_EXCHANGE_RATE_KEY=your-unipass-exchange-rate-key
